{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix miniapp",
  "buildCommand": "npm run build --prefix miniapp",
  "outputDirectory": "miniapp/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "backend/app/**",
      "excludeFiles": "{backend/tests/**,backend/data/**,miniapp/**,deploy/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
