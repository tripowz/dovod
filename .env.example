# Скопируйте в .env и заполните. .env в git не коммитится.

# --- база и сервер ---
# Локально — SQLite. На сервере — Postgres: postgresql+asyncpg://user:pass@host/dovod
DATABASE_URL=sqlite+aiosqlite:///./dovod.db
API_HOST=127.0.0.1
API_PORT=8010
CORS_ORIGINS=http://localhost:5174

# Публичный HTTPS-адрес мини-аппа. Telegram не откроет http и localhost.
# Для пилота подойдёт туннель: cloudflared tunnel --url http://localhost:5174
MINIAPP_URL=

# --- Telegram: запись (бот) ---
# Создайте бота у @BotFather и вставьте токен. Без него вход в мини-апп
# невозможен: подпись initData проверяется этим токеном.
BOT_TOKEN=
# Ваш Telegram ID. Узнать: запустите бота и напишите ему /id.
MANAGER_TG_USER_ID=
MANAGER_NAME=Бекзод

# --- Telegram: чтение (user-API, my.telegram.org → API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=./data/dovod.session
# Предохранитель: Telethon только читает. Не выключайте — иначе система
# сможет писать клиентам от имени живого сотрудника.
TELETHON_READ_ONLY=true

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Средняя модель: Sonnet (между Haiku — низкая и Opus — высокая).
MODEL_ANALYZE=claude-sonnet-5-5
EFFORT_ANALYZE=low
MODEL_DIGEST=claude-sonnet-5-5
EFFORT_DIGEST=medium

# --- разбор чатов ---
ANALYZE_INTERVAL_MINUTES=15
ANALYZE_BATCH_SIZE=30
BACKFILL_LIMIT=200
# Ниже этого порога предложение не показывается. На пилоте выше обычного:
# один ложный «перенос срока» отобьёт желание нажимать «Применить».
PROPOSAL_MIN_CONFIDENCE=0.6

# История: сообщения старше этого (в часах) не идут во «Входящие» и не
# создают заявок с SLA — по ним давно ответили.
FRESH_HOURS=24

# --- служебный аккаунт поддержки ---
# Отели пишут в личку служебному аккаунту — считать это обращениями в
# поддержку (заявки с таймером SLA).
PRIVATE_AS_SUPPORT=false
# Основание читать новые чаты. Задано — чаты, появившиеся потом, включаются
# сами с этой записью о согласии. Пусто — ждут руководителя.
NEW_CHATS_CONSENT=

# --- обещания клиенту, в минутах ---
SLA_FIRST_REPLY_MINUTES=15
SLA_RESOLVE_MINUTES=240

# --- сводка и экономика ---
DIGEST_HOUR_LOCAL=9
TIMEZONE=Asia/Tashkent
# Стоимость часа обслуживания, сум. На ней держится вывод «удерживать или
# чинить причину» в карточке клиента — цифру надо утвердить осознанно.
SERVICE_HOUR_COST=60000
